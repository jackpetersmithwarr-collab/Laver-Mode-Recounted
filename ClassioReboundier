    print("Entity is despawning")

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local colorCorrection = Instance.new("ColorCorrectionEffect")
colorCorrection.Name = "ReboundBlue"
colorCorrection.TintColor = Color3.fromRGB(0, 120, 255)
colorCorrection.Saturation = 2.5
colorCorrection.Contrast = 0.5
colorCorrection.Parent = Lighting

local sound1 = Instance.new("Sound")
sound1.SoundId = "rbxassetid://9125712877"
sound1.Volume = 2.5
sound1.Pitch = 0.85
sound1.Parent = SoundService
sound1:Play()

sound1.Ended:Connect(function()
	sound1:Destroy()
end)

local sound2 = Instance.new("Sound")
sound2.SoundId = "rbxassetid://129361797081977"
sound2.Volume = 2.5
sound2.Pitch = 0.6
sound2.Parent = SoundService
sound2:Play()

sound2.Ended:Connect(function()
	sound2:Destroy()
end)

local shakeIntensity = 4.0
local rotationIntensity = 5.0
local isShaking = true

local shakeConnection = RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	if camera and isShaking then
		local offsetX = math.random(-100, 100) / 1000 * shakeIntensity
		local offsetY = math.random(-100, 100) / 1000 * shakeIntensity
		
		local randomAngle = math.random(-100, 100) / 100 * rotationIntensity
		local offsetRotation = math.rad(randomAngle)
		
		camera.CFrame = camera.CFrame * CFrame.new(offsetX, offsetY, 0) * CFrame.Angles(0, 0, offsetRotation)
	end
end)

task.wait(0.4)

local longLinearTweenInfo = TweenInfo.new(8.0, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

local fadeTween = TweenService:Create(colorCorrection, longLinearTweenInfo, {
	TintColor = Color3.fromRGB(255, 255, 255),
	Saturation = 0,
	Contrast = 0
})
fadeTween:Play()

local intensityValue = Instance.new("NumberValue")
intensityValue.Value = 4.0
local shakeTween = TweenService:Create(intensityValue, longLinearTweenInfo, {Value = 0})

local changeConnection = intensityValue.Changed:Connect(function(newValue)
	shakeIntensity = newValue
	rotationIntensity = newValue * 1.25
end)
shakeTween:Play()

fadeTween.Completed:Connect(function()
	isShaking = false
	if shakeConnection then shakeConnection:Disconnect() end
	if changeConnection then changeConnection:Disconnect() end
	if colorCorrection then colorCorrection:Destroy() end
	if intensityValue then intensityValue:Destroy() end
end)

end)

