entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")

local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local originalAmbient = Lighting.Ambient
local originalOutdoorAmbient = Lighting.OutdoorAmbient
local originalColorShiftTop = Lighting.ColorShift_Top
local originalColorShiftBottom = Lighting.ColorShift_Bottom

local originalPartColors = {}
local keepTintedInstances = {}

local BRIGHT_PINK_RED = Color3.fromRGB(255, 30, 120) 
local DARK_PINK_RED = Color3.fromRGB(140, 10, 50) 

local TWEEN_TIME = 1.5 
local FADE_OUT_TIME = 4.0
local tweenInfoIn = TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local tweenInfoOutLinear = TweenInfo.new(FADE_OUT_TIME, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)

player.CharacterAdded:Connect(function(newCharacter)
	character = newCharacter
end)

local function isPlayerLight(instance)
	if instance:IsDescendantOf(character) then
		return true
	end
	local lightItem = instance:FindFirstAncestorOfClass("Tool")
	if lightItem and lightItem:IsDescendantOf(character) then
		return true
	end
	return false
end

local function tintObject(instance)
	if instance:IsA("BasePart") or instance:IsA("Light") then
		if not originalPartColors[instance] then
			originalPartColors[instance] = instance.Color
		end
		TweenService:Create(instance, tweenInfoIn, {Color = BRIGHT_PINK_RED}):Play()
	end
end

local function activateLuauShift()
	local lightingGoal = {
		Ambient = BRIGHT_PINK_RED,
		OutdoorAmbient = DARK_PINK_RED,
		ColorShift_Top = BRIGHT_PINK_RED,
		ColorShift_Bottom = DARK_PINK_RED
	}
	
	TweenService:Create(Lighting, tweenInfoIn, lightingGoal):Play()
	
	for _, descendant in ipairs(workspace:GetDescendants()) do
		tintObject(descendant)
	end
	
	_G.LuauDescendantConnection = workspace.DescendantAdded:Connect(function(newDescendant)
		task.wait()
		if not isPlayerLight(newDescendant) then
			keepTintedInstances[newDescendant] = true
		end
		tintObject(newDescendant)
	end)
end

local function resetLuauShift()
	if _G.LuauDescendantConnection then
		_G.LuauDescendantConnection:Disconnect()
		_G.LuauDescendantConnection = nil
	end

	local lightingGoal = {
		Ambient = originalAmbient,
		OutdoorAmbient = originalOutdoorAmbient,
		ColorShift_Top = originalColorShiftTop,
		ColorShift_Bottom = originalColorShiftBottom
	}
	
	TweenService:Create(Lighting, tweenInfoOutLinear, lightingGoal):Play()
	
	for instance, originalColor in pairs(originalPartColors) do
		if instance and instance.Parent then
			if isPlayerLight(instance) or not keepTintedInstances[instance] then
				TweenService:Create(instance, tweenInfoOutLinear, {Color = originalColor}):Play()
			end
		end
	end
	
	table.clear(originalPartColors)
	table.clear(keepTintedInstances)
end

task.wait(3)
activateLuauShift()

task.wait(10)
resetLuauShift()

end)

